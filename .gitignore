# Resultados de las corridas de k6: se conserva la carpeta, no su contenido.
# El volcado de "-o json=" puede pesar cientos de MB por corrida.
perf/results/*
!perf/results/.gitkeep
# Evidencia final, compacta y comparable de las corridas que se documentan.
!perf/results/README.md
